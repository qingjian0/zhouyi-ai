{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qingjian0/zhouyi-ai/schemas/yixiang-analogy-transfer-casebook.schema.json",
  "title": "Zhouyi-AI M17 analogy transfer casebook",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "casebook_id",
    "primary_text",
    "policy",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "casebook_id": {
      "type": "string",
      "minLength": 1
    },
    "primary_text": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "passage",
          "source_ref",
          "audit_focus",
          "note"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "passage": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "audit_focus": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
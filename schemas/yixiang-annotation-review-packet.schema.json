{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zhouyi-AI M19 human review packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "claim_kind",
    "independence_group",
    "source",
    "annotations",
    "adjudication"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_kind": {
      "type": "string",
      "minLength": 1
    },
    "independence_group": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_status",
        "work_id",
        "edition_id",
        "witness_id",
        "locator",
        "transcription",
        "verification_refs",
        "verified_by",
        "verification_note"
      ],
      "properties": {
        "source_status": {
          "enum": [
            "verified_primary",
            "critical_edition",
            "unverified_transcription",
            "secondary_quotation",
            "research_hypothesis"
          ]
        },
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "edition_id": {
          "type": "string",
          "minLength": 1
        },
        "witness_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "transcription": {
          "type": "string",
          "minLength": 1
        },
        "verification_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verified_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "annotations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "decision",
          "claim",
          "text_layer",
          "shared_basis",
          "non_shared_basis",
          "scope_conditions",
          "required_invariants",
          "known_counterexamples",
          "causal_status",
          "evidence_refs",
          "rationale"
        ],
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "accept",
              "reject",
              "conditional",
              "abstain"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "text_layer": {
            "type": "string",
            "minLength": 1
          },
          "shared_basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "non_shared_basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_invariants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "known_counterexamples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "causal_status": {
            "enum": [
              "symbolic",
              "normative",
              "co_occurrence",
              "correlational",
              "mechanistic_hypothesis",
              "intervention_supported",
              "unknown"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "adjudication": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "decision",
        "adjudicator_id",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "decision": {
          "enum": [
            "accept",
            "reject",
            "conditional",
            "abstain"
          ]
        },
        "adjudicator_id": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
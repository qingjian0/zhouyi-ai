  ],
  "engineering_mapping": {
    "m2": "将五阶段建模为有序但可分支的认知证据链。",
    "m3": "竞争解释必须声明其同异维度、感知通道和名实对齐证据。",
    "m4": "干预通道、位置、外观、时间及约定，检查判断是否稳健。",
    "m5": "选择能区分竞争假设的观测通道与属性。",
    "m8": "覆盖通道错配、同名异物、形变连续性及局部同异误判。"
  },
  "inference_policy": {
    "unknown_is_not_false": true,
    "local_match_does_not_imply_global_identity": true,
    "name_match_does_not_imply_referent_identity": true,
    "appearance_change_does_not_imply_entity_change": true,
    "required_failure_output": [
      "ABSTAIN",
      "UNRESOLVED"
    ]
  }

  "stages": [
    {
      "stage_id": "S1_SENSORY_DISCRIMINATION",
      "order": 1,
      "source_term": "天官",
      "textual_anchor": "形体、色理以目异；声音清浊以耳异；甘苦咸淡以口异",
      "function": "按感知通道取得对象属性差异",
      "required_evidence": [
        "observation_ref",
        "sensory_or_measurement_channel",
        "property_dimension",
        "observation_conditions"
      ],
      "failure_modes": [
        "channel_mismatch",
        "unobserved_property_treated_as_absent",
        "measurement_context_shift"
      ]
    },
    {
      "stage_id": "S2_EVIDENCE_GROUNDED_RECOGNITION",
      "order": 2,
      "source_term": "征知",
      "textual_anchor": "征知必将待天官之当簿其类，然后可也",
      "function": "判断须受相应观察记录约束",
      "required_evidence": [
        "observation_ref",
        "classification_warrant"
      ],
      "failure_modes": [
        "inference_without_observation",
        "unknown_treated_as_known",
        "cross_channel_substitution"
      ]
    },
    {
      "stage_id": "S3_DIMENSIONAL_SAME_DIFFERENT",
      "order": 3,
      "source_term": "同异",
      "textual_anchor": "然后随而命之，同则同之，异则异之",
      "function": "按明确属性或关系维度判定同异",
      "required_evidence": [
        "comparison_dimension",
        "shared_basis",
        "non_shared_basis"
      ],
      "failure_modes": [
        "global_same_from_local_match",
        "global_different_from_local_difference",
        "dimension_unspecified"
      ]
    },
    {
      "stage_id": "S4_CLASS_AND_NAMING",
      "order": 4,
      "source_term": "共名/别名/约定",
      "textual_anchor": "物也者，大共名也；鸟兽也者，大别名也；约定俗成谓之宜",
      "function": "建立可调整粒度的分类与共同体命名",
      "required_evidence": [
        "class_definition",
        "naming_convention_scope",
        "referent_evidence"
      ],
      "failure_modes": [
        "same_name_different_referent",
        "different_name_same_referent",
        "category_granularity_error"
      ]
    },
    {
      "stage_id": "S5_OBJECT_CONTINUITY",
      "order": 5,
      "source_term": "状/所/实/化",
      "textual_anchor": "同状而异所者…谓之二实；状变而实无别…谓之化",
      "function": "区分外观、个体化条件与对象连续性",
      "required_evidence": [
        "temporal_evidence",
        "continuity_basis",
        "identity_scope"
      ],
      "failure_modes": [
        "same_appearance_assumed_same_entity",
        "appearance_change_assumed_new_entity",
        "same_location_assumed_same_entity"
      ]
    }
  ],
  "transfer_gates": [
    "observation_comparability",
    "dimension_explicitness",
    "classification_basis",
    "name_referent_alignment",
    "identity_continuity_when_required",
